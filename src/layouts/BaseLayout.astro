---
// Brand fonts: Newsreader (with optical sizing) for headings, Inter for body
import '@fontsource-variable/newsreader/opsz.css';
import '@fontsource-variable/inter';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
import { pageGraph } from '../lib/structured-data';
import revealScript from '../scripts/reveal.js?raw';

interface Props {
  /** Page-specific title. The site name is added automatically. */
  title: string;
  /** One or two sentences (about 150 characters) for search results. */
  description?: string;
  /** Path to a 1200×630 sharing image in public/. */
  ogImage?: string;
  ogImageAlt?: string;
  /** Keep this page out of search results (e.g. the 404 page). */
  noindex?: boolean;
  /** Open Graph type: "article" for articles. */
  ogType?: 'website' | 'article';
  /** Extra JSON-LD nodes for this page (see src/lib/structured-data.ts). */
  structuredData?: Record<string, unknown>[];
}

const {
  title,
  description = site.defaultDescription,
  ogImage = site.ogImage,
  ogImageAlt = site.ogImageAlt,
  noindex = false,
  ogType = 'website',
  structuredData = [],
} = Astro.props;

const fullTitle = Astro.url.pathname === '/' ? `${site.name}: ${title}` : `${title} | ${site.name}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = new URL(ogImage, Astro.site);
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}

    <!-- Favicons are resized copies of the original app icon (src/assets/brand/lockstep-icon.png) -->
    <!-- Google shows the icon in search results and needs one at least 48px square -->
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="icon" href="/icon-192.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <!-- Safari on iPhone shows a "Get the app" banner for the Lockstep app. No script, nothing tracked. -->
    <meta name="apple-itunes-app" content={`app-id=${site.appStoreId}`} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <!-- Matches the page background (--color-cream) -->
    <meta name="theme-color" content="#FBF6E8" />

    <!-- Open Graph (link previews on social media and messaging apps) -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content={site.locale} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Structured data for search engines (not run by browsers). "<" is escaped so text
         such as "</script>" in an article title can't end the tag early. -->
    {
      !noindex && (
        <script
          is:inline
          type="application/ld+json"
          set:html={JSON.stringify(pageGraph(structuredData)).replace(/</g, '\\u003c')}
        />
      )
    }
    <slot name="head" />

    <!--
      The site's only JavaScript (allowed by Andrew, 2026-10-11): it marks .reveal
      elements and the staircase with .is-visible as they scroll into view, and
      CSS in global.css does the animating. It sends nothing anywhere. Without
      JavaScript, or with reduced motion on, everything simply shows as normal.
    -->
    <script is:inline set:html={revealScript} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to main content</a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    top: var(--space-2xs);
    left: var(--space-2xs);
    z-index: 100;
    padding: var(--space-2xs) var(--space-sm);
    background: var(--color-primary);
    color: var(--color-on-primary);
    border-radius: var(--radius-sm);
    transform: translateY(-200%);
  }

  .skip-link:focus {
    transform: none;
  }

  main:focus {
    outline: none;
  }
</style>
