---
import SupportSignpost from './SupportSignpost.astro';
import { navigation, site } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <SupportSignpost />

  <div class="site-footer__bottom">
    <div class="container site-footer__inner">
      <nav aria-label="Footer">
        <ul class="footer-links">
          {navigation.map((item) => (
            <li><a href={item.href}>{item.label}</a></li>
          ))}
        </ul>
      </nav>
      <p>
        <a href={`mailto:${site.email}`}>{site.email}</a>
      </p>
      <!-- TODO: confirm legal name, company number and registered address -->
      <p class="placeholder">© {year} Lockstep Ltd. [Company number and registered address: PLACEHOLDER]</p>
    </div>
  </div>
</footer>

<style>
  .site-footer__bottom {
    padding-block: var(--space-lg);
    background: var(--color-green);
    color: var(--color-cream);
    font-size: var(--text-sm);
  }

  .site-footer__inner {
    display: grid;
    gap: var(--space-sm);
  }

  .site-footer__bottom a {
    color: var(--color-cream);
  }

  .site-footer__bottom :focus-visible {
    outline-color: var(--color-cream);
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs) var(--space-md);
    padding: 0;
    list-style: none;
  }

  .site-footer__bottom .placeholder {
    color: var(--color-charcoal);
  }
</style>
