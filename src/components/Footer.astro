---
import { Image } from 'astro:assets';
import logo from '../assets/brand/lockstep-logo.png';
import { legalLinks, navigation, site } from '../data/site';
import { supportServices, urgentHelp } from '../data/support';

const year = new Date().getFullYear();
const helpline = supportServices.find((s) => s.phone)!;
---

<footer class="site-footer">
  <div class="site-footer__bottom">
    {!Astro.url.pathname.startsWith('/contact') && (
      <div class="container footer-support">
        <p>
          <strong>Need support now?</strong>{' '}
          {helpline.name}: <a href={`tel:${helpline.phone!.replace(/\s/g, '')}`}>{helpline.phone}</a>, free, 24/7.{' '}
          {urgentHelp.brief}{' '}
          <a href="/contact/#support-heading">More support services</a>
        </p>
      </div>
    )}

    <div class="container site-footer__grid">
      <div class="site-footer__brand stack">
        <!-- Original logo on a cream tile, so it stays unaltered on the dark footer -->
        <a href="/" class="footer-logo">
          <Image src={logo} alt={`${site.name} home`} height={40} densities={[1, 2]} class="footer-logo__img" />
        </a>
        <p>Regain control. Redirect the urge.</p>
      </div>

      <nav aria-label="Footer">
        <h2 class="footer-heading">Explore</h2>
        <ul class="footer-links">
          <li><a href="/">Home</a></li>
          {navigation.map((item) => (
            <li><a href={item.href}>{item.label}</a></li>
          ))}
        </ul>
      </nav>

      <div>
        <h2 class="footer-heading">Get in touch</h2>
        <ul class="footer-links">
          <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
        </ul>
        <p class="site-footer__note">Questions and feedback are always welcome. We read every message.</p>
      </div>

      <nav aria-label="Legal">
        <h2 class="footer-heading">Legal</h2>
        <ul class="footer-links">
          {legalLinks.map((item) => (
            <li><a href={item.href}>{item.label}</a></li>
          ))}
        </ul>
      </nav>
    </div>

    <div class="container">
      <div class="site-footer__legal">
        <!-- As registered at Companies House (details in src/data/site.ts). -->
        <p>
          © {year} {site.company.legalName}. Registered in England and Wales, company number {site.company.number}.
          Registered office: {site.company.streetAddress}, {site.company.locality}, {site.company.postcode}.
        </p>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer__bottom {
    padding-block: var(--space-xl) var(--space-lg);
    background: var(--color-green);
    color: var(--color-on-dark-muted);
    font-size: var(--text-sm);
  }

  .footer-support {
    margin-bottom: var(--space-xl);
    padding-bottom: var(--space-md);
    border-bottom: 1px solid color-mix(in srgb, var(--color-cream) 18%, transparent);
  }

  .footer-support p {
    max-width: none;
  }

  .footer-support strong {
    color: var(--color-cream);
  }

  .site-footer__grid {
    display: grid;
    gap: var(--space-lg);
  }

  @media (min-width: 48rem) {
    .site-footer__grid {
      grid-template-columns: 1.6fr 1fr 1.3fr 1fr;
    }
  }

  .site-footer__bottom a {
    color: var(--color-cream);
  }

  .site-footer__bottom :focus-visible {
    outline-color: var(--color-cream);
  }

  .footer-logo {
    display: inline-flex;
    padding: var(--space-xs) var(--space-sm);
    border-radius: var(--radius-md);
    background: var(--color-cream);
  }

  .footer-logo :global(.footer-logo__img) {
    width: auto;
    height: 2.5rem;
  }

  .footer-heading {
    margin-bottom: var(--space-2xs);
    color: var(--color-cream);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: 0.04em;
  }

  .footer-links {
    display: grid;
    padding: 0;
    list-style: none;
  }

  /* Taller tap targets on touch screens (WCAG 2.2 target size) */
  .footer-links a {
    display: inline-block;
    padding-block: var(--space-3xs);
  }

  .site-footer__note {
    margin-top: var(--space-2xs);
  }

  .site-footer__legal {
    margin-top: var(--space-xl);
    padding-top: var(--space-md);
    border-top: 1px solid color-mix(in srgb, var(--color-cream) 18%, transparent);
  }
</style>
