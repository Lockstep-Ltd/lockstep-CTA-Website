---
// Vector trace of src/assets/brand/lock-steps.webp so it can animate.
import replayScript from '../scripts/lockmark-replay.js?raw';
---

<button class="lockmark-replay" type="button" aria-label="Replay the lock animation">
  <svg class="lockmark" viewBox="290 100 415 880" aria-hidden="true" focusable="false">
    <defs>
      <mask id="lockmark-keyhole" maskUnits="userSpaceOnUse" x="0" y="-400" width="1000" height="1800">
        <rect x="0" y="-400" width="1000" height="1800" fill="#fff" />
        <g class="lockmark__top">
          <circle cx="500" cy="455" r="36" />
          <path d="M486 470 L472 558 H528 L514 470 Z" />
        </g>
      </mask>
      <mask id="lockmark-carve" maskUnits="userSpaceOnUse" x="0" y="-400" width="1000" height="1800">
        <rect x="0" y="-400" width="1000" height="1800" fill="#fff" />
        <path class="lockmark__line" d="M333 975 V815 H478 V708 H598 V601 H705" pathLength="1"
          fill="none" stroke="#000" stroke-width="48" />
      </mask>
      <!-- The dropped top half overlaps the bottom; nothing shows below the lock's base -->
      <clipPath id="lockmark-base">
        <rect x="317" y="-400" width="363" height="1345" rx="26" />
      </clipPath>
    </defs>

    <g class="lockmark__stage">
      <circle class="lockmark__pulse" cx="498" cy="800" r="230" fill="none" stroke="currentColor" stroke-width="6" />
      <g class="lockmark__squash" clip-path="url(#lockmark-base)" mask="url(#lockmark-keyhole)">
        <!-- One solid body while the line carves through it, so there are no seams -->
        <path class="lockmark__solid" mask="url(#lockmark-carve)" fill="currentColor"
          d="M317 960 V369 Q317 343 343 343 H654 Q680 343 680 369 V960 Z" />
        <!-- Swapped in for the solid body just as the top starts to fall -->
        <path class="lockmark__piece" fill="currentColor"
          d="M357 960 V839 H502 V732 H622 V625 H680 V960 Z" />
        <!-- Shown only while a tap stretches the padlock back up to the tall solid lock -->
        <rect class="lockmark__rewind lockmark__column" x="317" y="380" width="363" height="580" fill="currentColor" />
        <g class="lockmark__top">
          <g class="lockmark__lift">
            <path class="lockmark__shackle" d="M393.5 400 V282 A104.75 104.75 0 0 1 603.25 282 V400" fill="none" stroke="currentColor" stroke-width="54.5" />
          </g>
          <path class="lockmark__piece" fill="currentColor"
            d="M317 791 V369 Q317 343 343 343 H654 Q680 343 680 369 V577 H574 V684 H454 V791 Z" />
          <path class="lockmark__rewind" fill="currentColor" d="M317 420 V369 Q317 343 343 343 H654 Q680 343 680 369 V420 Z" />
        </g>
      </g>
    </g>
  </svg>
  <span class="lockmark-shadow" aria-hidden="true"></span>
</button>

<script is:inline set:html={replayScript} />

<style>
  .lockmark-replay {
    position: relative;
    display: block;
    height: 100%;
    padding: 0;
    border: 0;
    border-radius: var(--radius-md);
    background: none;
    overflow: visible;
    cursor: pointer;
  }

  .lockmark {
    display: block;
    width: auto;
    max-width: 100%;
    height: 100%;
    color: var(--color-emerald);
    overflow: visible;
  }

  .lockmark__pulse,
  .lockmark__rewind {
    opacity: 0;
  }

  .lockmark-shadow {
    position: absolute;
    left: 50%;
    top: 87%;
    width: 48%;
    height: 4%;
    margin-left: -24%;
    border-radius: 50%;
    background: radial-gradient(closest-side, color-mix(in srgb, var(--color-emerald) 35%, transparent), transparent);
    pointer-events: none;
  }

  .lockmark__column {
    transform-box: fill-box;
    transform-origin: bottom;
  }

  /* !important so these beat the running animations' opacity */
  .is-rewinding .lockmark__rewind {
    opacity: 1 !important;
  }

  .is-rewinding :is(.lockmark__piece, .lockmark__solid, .lockmark__pulse) {
    opacity: 0 !important;
  }

  .lockmark__line {
    stroke-dasharray: 1;
  }

  .lockmark__lift {
    transition: transform 0.45s var(--ease-out);
  }

  /* Without motion, show the finished padlock */
  .lockmark__solid {
    opacity: 0;
  }

  .lockmark__top {
    transform: translateY(256px);
  }

  .lockmark__stage {
    transform: translateY(-128px);
  }

  @media (prefers-reduced-motion: no-preference) {
    /* On the whole SVG, not a group inside it, so the masked artwork isn't repainted each frame */
    .lockmark {
      animation: lockmark-float 6s ease-in-out 3.6s infinite;
    }

    .lockmark-shadow {
      animation: lockmark-shadow 6s ease-in-out 3.6s infinite;
    }

    .lockmark__shackle {
      animation: lockmark-click 9s 5s infinite;
    }

    .lockmark__line {
      animation: lockmark-carve 1s cubic-bezier(0.65, 0, 0.35, 1) 0.6s both;
    }

    .lockmark__solid {
      animation: lockmark-hide 2.1s step-end both;
    }

    .lockmark__piece {
      animation: lockmark-show 2.1s step-end both;
    }

    .lockmark__top {
      animation: lockmark-drop 0.8s 2.1s both;
    }

    .lockmark__stage {
      animation: lockmark-centre 0.9s cubic-bezier(0.65, 0, 0.35, 1) 2.1s both;
    }

    .lockmark__squash {
      transform-box: fill-box;
      transform-origin: bottom;
      animation: lockmark-thunk 0.45s var(--ease-out) 2.62s;
    }

    .lockmark__pulse {
      transform-box: fill-box;
      transform-origin: center;
      animation: lockmark-pulse 1.1s var(--ease-out) 2.62s;
    }

    /* Hovering the artwork lifts the shackle; leaving lets it click shut again */
    :global(.hero__art:hover) .lockmark__lift {
      transform: translateY(-26px);
    }
  }

  @keyframes lockmark-carve {
    from { stroke-dashoffset: 1; }
    to { stroke-dashoffset: 0; }
  }

  @keyframes lockmark-hide {
    from { opacity: 1; }
    to { opacity: 0; }
  }

  @keyframes lockmark-show {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  /* Falls under gravity, lands, settles with a small bounce */
  @keyframes lockmark-drop {
    0% { transform: none; animation-timing-function: cubic-bezier(0.55, 0, 0.9, 0.4); }
    65% { transform: translateY(256px); animation-timing-function: var(--ease-out); }
    80% { transform: translateY(244px); animation-timing-function: cubic-bezier(0.5, 0, 0.75, 0); }
    100% { transform: translateY(256px); }
  }

  @keyframes lockmark-centre {
    from { transform: none; }
    to { transform: translateY(-128px); }
  }

  @keyframes lockmark-thunk {
    35% { transform: scale(1.015, 0.975); }
  }

  @keyframes lockmark-pulse {
    from { opacity: 0.35; transform: scale(0.7); }
    to { opacity: 0; transform: scale(1.25); }
  }

  @keyframes lockmark-float {
    50% { transform: translateY(-12px); }
  }

  @keyframes lockmark-shadow {
    50% { transform: scale(0.82); opacity: 0.55; }
  }

  @keyframes lockmark-click {
    0%, 86% { transform: none; animation-timing-function: var(--ease-out); }
    90% { transform: translateY(-30px); animation-timing-function: cubic-bezier(0.55, 0, 0.9, 0.4); }
    93% { transform: none; animation-timing-function: var(--ease-out); }
    95% { transform: translateY(-5px); animation-timing-function: cubic-bezier(0.55, 0, 0.9, 0.4); }
    96.5%, 100% { transform: none; }
  }
</style>
