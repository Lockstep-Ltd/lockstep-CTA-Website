---
// Monochrome Instagram and LinkedIn glyphs, inline so there are no third-party requests.
// They take the text colour (currentColor). Decorative: the link carries the name.
interface Props {
  name: 'Instagram' | 'LinkedIn';
}

const { name } = Astro.props;
---

<svg class="social-icon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
  {name === 'Instagram' && (
    <g fill="none" stroke="currentColor" stroke-width="1.8">
      <rect x="3" y="3" width="18" height="18" rx="5" />
      <circle cx="12" cy="12" r="4.2" />
      <circle cx="17.4" cy="6.6" r="0.6" fill="currentColor" stroke="none" />
    </g>
  )}
  {name === 'LinkedIn' && (
    <path
      fill="currentColor"
      d="M5.2 3.5a1.95 1.95 0 1 1 0 3.9 1.95 1.95 0 0 1 0-3.9ZM3.5 9h3.4v11.5H3.5V9Zm5.6 0h3.25v1.57h.05c.45-.86 1.56-1.77 3.21-1.77 3.43 0 4.06 2.26 4.06 5.2v6.5h-3.39v-5.76c0-1.37-.02-3.14-1.91-3.14-1.92 0-2.21 1.5-2.21 3.04v5.86H9.1V9Z"
    />
  )}
</svg>
