---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SupportSignpost from '../components/SupportSignpost.astro';
import { site } from '../data/site';
// Search description approved by Andrew, 2026-10-11.
// No contact form yet: we'll add one once we've agreed how submissions are stored and handled.
---

<BaseLayout title="Contact" description="Email the Lockstep team at contact@lockstep.uk with questions, feedback or partnership ideas.">
  <PageHero eyebrow="Contact" title="Get in touch">
    <p>
      Questions and feedback are always welcome. We read every message, whether you use
      Lockstep, want to partner with us or are interested in supporting our work.
    </p>
    <p>
      Email us at <a href={`mailto:${site.email}`}>{site.email}</a>
    </p>
    <p>
      We're a small team and can't offer one-to-one support by email. If you'd like to talk to
      someone about gambling, the services below can help.
    </p>
  </PageHero>

  <SupportSignpost />
</BaseLayout>
