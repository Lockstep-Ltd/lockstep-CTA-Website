---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Staircase from '../components/Staircase.astro';
import Figure from '../components/Figure.astro';
import { ethics, status, steps } from '../data/product';
---

<BaseLayout
  title="How it works"
  description="How Lockstep helps you interrupt urges, grow daily, connect with others and keep your progress going."
>
  <PageHero title="How Lockstep works">
    <p>
      Lockstep helps you navigate different situations, with practical support that goes beyond
      high-risk moments.
    </p>
  </PageHero>

  <section class="section section--surface" aria-labelledby="steps-heading">
    <div class="container stack-lg">
      <h2 id="steps-heading" class="reveal">Four steps, at your own pace</h2>
      <Staircase steps={steps} />
    </div>
  </section>

  <section class="section" aria-labelledby="tools-heading">
    <div class="container stack-lg">
      <h2 id="tools-heading" class="reveal">Inside the app</h2>
      <div class="grid grid--2">
        <article class="card stack reveal">
          <Figure alt="Screenshot of the Lockstep app" placeholder="PLACEHOLDER: app screenshot" />
          <h3 class="placeholder">[PLACEHOLDER: Feature name]</h3>
          <p class="placeholder">[PLACEHOLDER: what it does and who it's for, in one or two sentences.]</p>
        </article>
        <article class="card stack reveal">
          <Figure alt="Screenshot of the Lockstep app" placeholder="PLACEHOLDER: app screenshot" />
          <h3 class="placeholder">[PLACEHOLDER: Feature name]</h3>
          <p class="placeholder">[PLACEHOLDER: what it does and who it's for, in one or two sentences.]</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section section--dark" aria-labelledby="ethics-heading">
    <div class="container stack-lg">
      <div class="stack reveal">
        <h2 id="ethics-heading">Ethics &amp; transparency</h2>
        <p class="lead">
          We're committed to building every part of the app responsibly and transparently.
          Here's what that means in practice.
        </p>
      </div>
      <dl class="ethics">
        {ethics.map((item) => (
          <div class="ethics__item reveal">
            <dt>{item.title}</dt>
            <dd>{item.text}</dd>
          </div>
        ))}
      </dl>
      <p class="reveal">
        <a class="text-link" href="/privacy_policy">Read the full privacy policy <span class="arrow" aria-hidden="true">→</span></a>
      </p>
    </div>
  </section>

  <section class="section" aria-labelledby="status-heading">
    <div class="container status-block reveal">
      <h2 id="status-heading">{status.label}</h2>
      <p class="lead">{status.text}</p>
      <p>{status.note}</p>
      <!-- TODO: add the early access / download link once confirmed -->
      <p><a class="button" href="/contact/">Get in touch <span class="arrow" aria-hidden="true">→</span></a></p>
    </div>
  </section>
</BaseLayout>

<style>
  .ethics {
    display: grid;
    gap: var(--space-md);
  }

  @media (min-width: 48rem) {
    .ethics {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-lg);
    }
  }

  .ethics__item {
    padding-top: var(--space-sm);
    border-top: 2px solid color-mix(in srgb, var(--color-cream) 35%, transparent);
  }

  .ethics dt {
    color: var(--color-cream);
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    font-weight: 600;
  }

  .ethics dd {
    margin-top: var(--space-2xs);
  }

  .status-block > * + * {
    margin-top: var(--space-sm);
  }
</style>
