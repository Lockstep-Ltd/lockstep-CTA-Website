---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Staircase from '../components/Staircase.astro';
import { chromeExtension, ethics, features, steps } from '../data/product';
// Search description: "reduce gambling" added for search engines (approved by Andrew, 2026-10-11).
---

<BaseLayout
  title="How it works"
  description="How Lockstep helps you reduce gambling: interrupt urges, grow daily, connect with others and keep your progress going."
>
  <PageHero title="How Lockstep works">
    <p>
      Lockstep helps you navigate different situations, with practical support that goes beyond
      high-risk moments.
    </p>
  </PageHero>

  <section class="section section--surface" aria-labelledby="steps-heading">
    <div class="container stack-lg">
      <h2 id="steps-heading" class="reveal">Four steps, at your own pace</h2>
      <Staircase steps={steps} />
    </div>
  </section>

  <section class="section" aria-labelledby="tools-heading">
    <div class="container stack-lg">
      <h2 id="tools-heading" class="reveal">Inside the app</h2>
      <!-- Screenshots left out for now. To add them later, put the images in
           src/assets/images/, add an image to each card in src/data/product.ts and
           show it with <Figure src={...} alt="..."> above the <h3>. -->
      <div class="grid grid--2">
        {features.cards.map((card) => (
          <article class="card stack reveal">
            <h3>{card.title}</h3>
            <p>{card.text}</p>
          </article>
        ))}
      </div>
      <div class="stack reveal">
        <h3 id="more-heading">Also in the app</h3>
        <ul class="feature-list" aria-labelledby="more-heading">
          {features.more.map((item) => <li>{item}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="section section--surface" aria-labelledby="extension-heading">
    <div class="container stack reveal">
      <div>
        <p class="kicker">Chrome extension</p>
        <h2 id="extension-heading">{chromeExtension.name}</h2>
      </div>
      <p class="lead">{chromeExtension.text}</p>
      <p><a class="button" href={chromeExtension.storeUrl}>Add to Chrome</a></p>
    </div>
  </section>

  <section class="section section--dark" aria-labelledby="ethics-heading">
    <div class="container stack-lg">
      <div class="stack reveal">
        <h2 id="ethics-heading">Ethics &amp; transparency</h2>
        <p class="lead">
          We're committed to building every part of the app responsibly and transparently.
          Here's what that means in practice.
        </p>
      </div>
      <dl class="ethics">
        {ethics.map((item) => (
          <div class="ethics__item reveal">
            <dt>{item.title}</dt>
            <dd>{item.text}</dd>
          </div>
        ))}
      </dl>
      <p class="reveal">
        <a class="text-link" href="/privacy_policy/">Read the full privacy policy <span class="arrow" aria-hidden="true">→</span></a>
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .feature-list {
    display: grid;
    gap: var(--space-xs) var(--space-lg);
    padding: 0;
    list-style: none;
  }

  @media (min-width: 48rem) {
    .feature-list {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .feature-list li {
    position: relative;
    padding-left: 1.75em;
  }

  /* Tick drawn in CSS, so screen readers just hear the list */
  .feature-list li::before {
    content: '';
    position: absolute;
    left: 0.2em;
    top: 0.35em;
    width: 0.45em;
    height: 0.8em;
    border: solid var(--color-emerald);
    border-width: 0 2px 2px 0;
    transform: rotate(45deg);
  }

  .ethics {
    display: grid;
    gap: var(--space-md);
  }

  @media (min-width: 48rem) {
    .ethics {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-lg);
    }
  }

  .ethics__item {
    padding-top: var(--space-sm);
    border-top: 2px solid color-mix(in srgb, var(--color-cream) 35%, transparent);
  }

  .ethics dt {
    color: var(--color-cream);
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    font-weight: 600;
  }

  .ethics dd {
    margin-top: var(--space-2xs);
  }
</style>
