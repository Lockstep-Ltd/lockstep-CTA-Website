---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Staircase from '../components/Staircase.astro';
import { ethics, status, steps } from '../data/product';
import { site } from '../data/site';
---

<BaseLayout
  title="How it works"
  description="How Lockstep helps you interrupt urges, grow daily, connect with others and keep your progress going."
>
  <PageHero title="How Lockstep works">
    <p>
      Lockstep helps you navigate different situations, with practical support that goes beyond
      high-risk moments.
    </p>
  </PageHero>

  <section class="section section--surface" aria-labelledby="steps-heading">
    <div class="container stack-lg">
      <h2 id="steps-heading" class="reveal">Four steps, at your own pace</h2>
      <Staircase steps={steps} />
    </div>
  </section>

  <section class="section" aria-labelledby="tools-heading">
    <div class="container stack-lg">
      <h2 id="tools-heading" class="reveal">Inside the app</h2>
      <!-- Screenshots left out for now. To add them later, put the images in
           src/assets/images/ and add a <Figure src={...} alt="..."> above each <h3>. -->
      <div class="grid grid--2">
        <article class="card stack reveal">
          <h3>Swap the Night</h3>
          <p>
            Tell us what you were planning to spend and the kind of night you're after, then
            swipe through real events and things to do from Skiddle and Ticketmaster that you
            could spend it on instead.
          </p>
        </article>
        <article class="card stack reveal">
          <h3>Relevant Meetings</h3>
          <p>
            Find support meetings with people in a similar situation to you. Lockstep matches
            meetings to you and your circumstances, and shows how relevant each one is as a
            percentage.
          </p>
        </article>
      </div>
    </div>
  </section>

  <section class="section section--dark" aria-labelledby="ethics-heading">
    <div class="container stack-lg">
      <div class="stack reveal">
        <h2 id="ethics-heading">Ethics &amp; transparency</h2>
        <p class="lead">
          We're committed to building every part of the app responsibly and transparently.
          Here's what that means in practice.
        </p>
      </div>
      <dl class="ethics">
        {ethics.map((item) => (
          <div class="ethics__item reveal">
            <dt>{item.title}</dt>
            <dd>{item.text}</dd>
          </div>
        ))}
      </dl>
      <p class="reveal">
        <a class="text-link" href="/privacy_policy">Read the full privacy policy <span class="arrow" aria-hidden="true">→</span></a>
      </p>
    </div>
  </section>

  <section class="section" aria-labelledby="status-heading">
    <div class="container status-block reveal">
      <h2 id="status-heading">{status.label}</h2>
      <p class="lead">{status.text}</p>
      <p>{status.note}</p>
      <div class="button-row">
        <a class="button" href={site.appStoreUrl}>Download on the App Store <span class="arrow" aria-hidden="true">→</span></a>
        <a class="button button--secondary" href="/contact/">Get in touch</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .ethics {
    display: grid;
    gap: var(--space-md);
  }

  @media (min-width: 48rem) {
    .ethics {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-lg);
    }
  }

  .ethics__item {
    padding-top: var(--space-sm);
    border-top: 2px solid color-mix(in srgb, var(--color-cream) 35%, transparent);
  }

  .ethics dt {
    color: var(--color-cream);
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    font-weight: 600;
  }

  .ethics dd {
    margin-top: var(--space-2xs);
  }

  .status-block > * + * {
    margin-top: var(--space-sm);
  }
</style>
