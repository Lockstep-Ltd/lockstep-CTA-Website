---
import BaseLayout from '../layouts/BaseLayout.astro';
import LockMark from '../components/LockMark.astro';
import Staircase from '../components/Staircase.astro';
import SwapDeck from '../components/SwapDeck.astro';
import ArticleCard from '../components/ArticleCard.astro';
import PartnerIcon from '../components/PartnerIcon.astro';
import { getArticles } from '../lib/articles';
import { about, commitments, heroNote, status, steps, tagline } from '../data/product';
import { site } from '../data/site';

const [latest, ...recent] = await getArticles();
---

<BaseLayout title="Regain control. Redirect the urge." description={tagline.summary}>
  <section class="hero">
    <div class="container hero__grid">
      <div class="hero__copy">
        <h1 class="enter" style="--i: 1">
          {tagline.headline.split(/(?<=\.) /).map((line) => <span class="hero__line">{line}</span>)}
        </h1>
        <p class="lead enter" style="--i: 2">{tagline.summary}</p>
        <p class="hero__note enter" style="--i: 2">{heroNote}</p>
        <div class="button-row enter" style="--i: 3">
          <a class="app-store-badge" href={site.appStoreUrl}><img src="/app-store-badge.svg" alt="Download on the App Store" width="150" height="50" /></a>
          <a class="button button--secondary" href="/how-it-works/">See how it works</a>
        </div>
        <p class="hero__android enter" style="--i: 3">{status.androidShort}</p>
      </div>

      <div class="hero__art enter" style="--i: 2">
        <LockMark />
      </div>
    </div>
  </section>

  <section class="commitments" aria-label="What we stand for">
    <ul class="container commitments__list" role="list">
      {commitments.map((item, i) => (
        <li class="reveal commitment">
          <svg class="commitment__icon" viewBox="0 0 48 48" aria-hidden="true">
            {i === 0 && (
              <>
                <path class="draw" pathLength="1" d="M4 32 L8 25 L12 33 L16 24 L20 31 C26 26 32 22 42 22" />
                <path class="draw draw--late commitment__arrow" pathLength="1" d="M35 15 L42 22 L35 29" />
              </>
            )}
            {i === 1 && (
              <g class="commitment__eye">
                <path class="draw" pathLength="1" d="M4 24 C12 12 36 12 44 24 C36 36 12 36 4 24 Z" />
                <circle class="draw draw--late commitment__pupil" pathLength="1" cx="24" cy="24" r="6" />
              </g>
            )}
            {i === 2 && (
              <>
                <clipPath id="commitment-shield">
                  <path d="M24 4 L40 10 V22 C40 33 33 40 24 44 C15 40 8 33 8 22 V10 Z" />
                </clipPath>
                <g clip-path="url(#commitment-shield)"><rect class="commitment__sheen" x="-30" y="0" width="14" height="48" /></g>
                <path class="draw" pathLength="1" d="M24 4 L40 10 V22 C40 33 33 40 24 44 C15 40 8 33 8 22 V10 Z" />
                <path class="draw draw--late" pathLength="1" d="M17 24 L22 29 L31 19" />
              </>
            )}
          </svg>
          <span>{item}</span>
        </li>
      ))}
    </ul>
  </section>

  <section class="section section--dark night" aria-labelledby="swap-heading">
    <div class="container night__grid">
      <div class="stack-lg reveal">
        <h2 id="swap-heading" class="night__title">Same money. Better night.</h2>
        <p>Had money set aside for a bet tonight? Swap the Night shows you real things happening near you, within that budget. Swipe past what doesn't appeal, keep what does.</p>
        <ul class="what__highlights night__points" role="list">
          <li>Events near you, tonight</li>
          <li>Matched to the money you'd have staked</li>
          <li>Or a night in that feels like a treat</li>
        </ul>
      </div>
      <SwapDeck />
    </div>
  </section>

  <section class="section section--surface" aria-labelledby="how-heading">
    <div class="container">
      <div class="section-head reveal">
        <div class="stack">
          <h2 id="how-heading">How Lockstep works</h2>
          <p class="lead">Practical support that goes beyond high-risk moments.</p>
        </div>
        <a class="text-link" href="/how-it-works/">More on how it works <span class="arrow" aria-hidden="true">→</span></a>
      </div>
      <Staircase steps={steps} />
    </div>
  </section>

  <section class="section section--dark" aria-labelledby="what-heading">
    <div class="container what">
      <h2 id="what-heading" class="what__statement reveal">What is Lockstep</h2>
      <div class="what__body reveal">
        {about.paragraphs.slice(0, 2).map((text) => <p>{text}</p>)}
      </div>
      <ul class="what__highlights reveal" role="list">
        {about.highlights.map((item) => <li>{item}</li>)}
      </ul>
      <p class="reveal">
        <a class="text-link what__more" href="/about/">More about Lockstep <span class="arrow" aria-hidden="true">→</span></a>
      </p>
    </div>
  </section>

  {latest && (
    <section class="section" aria-labelledby="articles-heading">
      <div class="container">
        <div class="section-head reveal">
          <div class="stack">
            <h2 id="articles-heading">Articles &amp; insights</h2>
            <p class="lead">Ideas, research and stories about gambling, habits and regaining control.</p>
          </div>
          <a class="text-link" href="/articles/">All articles <span class="arrow" aria-hidden="true">→</span></a>
        </div>
        <div class="articles">
          <div class="reveal">
            <ArticleCard article={latest} variant="feature" />
          </div>
          <ul class="articles__rest" role="list">
            {recent.slice(0, 3).map((article) => (
              <li class="reveal"><ArticleCard article={article} /></li>
            ))}
          </ul>
        </div>
      </div>
    </section>
  )}

  <section class="section section--surface" id="status" aria-labelledby="status-heading">
    <div class="container product-status reveal">
      <div class="stack">
        <h2 id="status-heading">Product status</h2>
        <p class="product-status__badge">{status.label}</p>
      </div>
      <div class="stack">
        <p class="lead">{status.text}</p>
        <p>{status.note}</p>
        <p>{status.android}</p>
        <div class="button-row">
          <a class="app-store-badge" href={site.appStoreUrl}><img src="/app-store-badge.svg" alt="Download on the App Store" width="150" height="50" /></a>
        </div>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="partner-heading">
    <div class="container">
      <div class="cta-panel section--dark partner reveal">
        <div class="stack-lg">
          <div class="partner__icons">
            <PartnerIcon name="university" />
            <PartnerIcon name="charity" />
            <PartnerIcon name="funder" />
          </div>
          <h2 id="partner-heading">Working with universities, charities and funders</h2>
          <p class="lead">
            If your organisation supports people affected by gambling, or you'd like to help
            Lockstep grow, we'd like to hear from you.
          </p>
        </div>
        <a class="button button--light" href="/partner/">Partner with us <span class="arrow" aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Hero */
  .hero {
    padding-block: var(--space-xl) var(--space-2xl);
    overflow: clip;
  }

  .hero__grid {
    display: grid;
    gap: var(--space-xl);
    align-items: center;
  }

  @media (min-width: 56rem) {
    .hero__grid {
      grid-template-columns: 1.25fr 0.75fr;
      gap: var(--space-2xl);
    }

    /* Short enough that the commitments band sits fully in view on a typical laptop screen */
    .hero {
      padding-block: var(--space-xl);
    }
  }

  .hero__copy > * + * {
    margin-top: var(--space-md);
  }

  .hero h1 {
    font-size: clamp(2.5rem, 1.4rem + 3.8vw, 4.5rem);
    line-height: 1;
  }

  /* One sentence per line: "Regain control." / "Redirect the urge." */
  .hero__line {
    display: block;
  }

  .hero .lead {
    max-width: 46ch;
  }

  .hero__android {
    font-size: var(--text-sm);
  }

  .hero__note {
    color: var(--color-green);
    font-weight: 600;
  }

  .hero__art {
    display: grid;
    place-items: center;
    height: 26rem;
    padding: var(--space-xl) var(--space-lg);
  }

  /* Phones and tablets: the lock goes above the headline, smaller, so its
     animation plays on screen as the page opens rather than below the fold */
  @media (max-width: 55.99rem) {
    .hero {
      padding-top: var(--space-sm);
    }

    .hero__grid {
      gap: var(--space-sm);
    }

    .hero__art {
      order: -1;
      height: 12rem;
      padding: var(--space-sm) 0 0;
    }
  }

  /* Commitments band */
  .commitments {
    border-block: 1px solid var(--color-border);
  }

  .commitments__list {
    display: grid;
    padding-block: var(--space-md);
    list-style: none;
  }

  .commitments__list li {
    max-width: none;
    padding-block: var(--space-sm);
    color: var(--color-green);
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .commitments__list li + li {
    border-top: 1px solid var(--color-border);
  }

  .commitment {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
  }

  .commitment__icon {
    flex: none;
    width: 2.75rem;
    height: 2.75rem;
    fill: none;
    stroke: var(--color-emerald);
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-linejoin: round;
    overflow: visible;
  }

  @media (min-width: 48rem) {
    .commitment {
      flex-direction: column;
      align-items: flex-start;
    }

    .commitment__icon {
      width: 3.25rem;
      height: 3.25rem;
    }
  }

  .commitment__sheen {
    fill: color-mix(in srgb, var(--color-emerald) 25%, transparent);
    stroke: none;
    transform: skewX(-20deg);
    opacity: 0;
  }

  :is(.commitment__eye, .commitment__pupil, .commitment__arrow) {
    transform-box: fill-box;
    transform-origin: center;
  }

  @media screen and (prefers-reduced-motion: no-preference) {
    :global(.js-motion) .commitment .draw {
      stroke-dasharray: 1;
      stroke-dashoffset: 1;
    }

    :global(.js-motion) .commitment.is-visible .draw {
      animation: commitment-draw 900ms var(--ease-out) calc(var(--reveal-delay, 0ms) + 250ms) forwards;
    }

    :global(.js-motion) .commitment.is-visible .draw--late {
      animation-delay: calc(var(--reveal-delay, 0ms) + 850ms);
    }

    :global(.js-motion) .commitment.is-visible .commitment__arrow {
      animation:
        commitment-draw 600ms var(--ease-out) calc(var(--reveal-delay, 0ms) + 850ms) forwards,
        commitment-nudge 5s ease-in-out 3s infinite;
    }

    :global(.js-motion) .commitment.is-visible .commitment__eye {
      animation: commitment-blink 6s ease-in-out 3.5s infinite;
    }

    :global(.js-motion) .commitment.is-visible .commitment__pupil {
      animation:
        commitment-draw 600ms var(--ease-out) calc(var(--reveal-delay, 0ms) + 850ms) forwards,
        commitment-look 6s ease-in-out 3.5s infinite;
    }

    :global(.js-motion) .commitment.is-visible .commitment__sheen {
      animation: commitment-sheen 7s ease-in-out 4s infinite;
    }
  }

  @keyframes commitment-draw {
    to { stroke-dashoffset: 0; }
  }

  @keyframes commitment-nudge {
    0%, 70%, 100% { transform: none; }
    78% { transform: translateX(4px); }
    86% { transform: translateX(-1px); }
  }

  @keyframes commitment-blink {
    0%, 44%, 50%, 100% { transform: none; }
    47% { transform: scaleY(0.1); }
  }

  @keyframes commitment-look {
    0%, 15%, 100% { translate: 0 0; }
    22%, 34% { translate: -4px 0; }
    42%, 56% { translate: 4px 0; }
    64% { translate: 0 0; }
  }

  @keyframes commitment-sheen {
    0%, 70% { opacity: 0; transform: translateX(0) skewX(-20deg); }
    72% { opacity: 1; }
    90% { opacity: 1; transform: translateX(78px) skewX(-20deg); }
    92%, 100% { opacity: 0; transform: translateX(78px) skewX(-20deg); }
  }

  @media (min-width: 48rem) {
    .commitments__list {
      grid-template-columns: repeat(3, 1fr);
      padding-block: var(--space-lg);
    }

    .commitments__list li {
      padding: 0 var(--space-md);
    }

    .commitments__list li:first-child {
      padding-left: 0;
    }

    .commitments__list li + li {
      border-top: 0;
      border-left: 1px solid var(--color-border);
    }
  }

  /* Swap the Night */
  .night {
    position: relative;
    overflow: clip;
    background:
      radial-gradient(ellipse at 85% 0%, color-mix(in srgb, var(--color-emerald) 70%, transparent), transparent 60%),
      var(--color-green);
  }

  .night::before {
    content: '';
    position: absolute;
    inset: 0;
    opacity: 0.55;
    pointer-events: none;
    background-image:
      radial-gradient(1.5px 1.5px at 12% 18%, var(--color-cream), transparent),
      radial-gradient(1px 1px at 28% 72%, var(--color-cream), transparent),
      radial-gradient(1.5px 1.5px at 47% 12%, var(--color-cream), transparent),
      radial-gradient(1px 1px at 63% 88%, var(--color-cream), transparent),
      radial-gradient(1.5px 1.5px at 92% 40%, var(--color-cream), transparent),
      radial-gradient(1px 1px at 6% 90%, var(--color-cream), transparent);
  }

  @media (prefers-reduced-motion: no-preference) {
    .night::before {
      animation: twinkle 6s ease-in-out infinite alternate;
    }
  }

  @keyframes twinkle {
    to {
      opacity: 0.2;
    }
  }

  .night__grid {
    position: relative;
    display: grid;
    gap: var(--space-2xl);
    align-items: center;
  }

  @media (min-width: 56rem) {
    .night__grid {
      grid-template-columns: 1.1fr 0.9fr;
    }
  }

  .night__title {
    font-size: var(--text-3xl);
    line-height: 1.1;
  }

  @media (min-width: 48rem) {
    .what__highlights.night__points {
      grid-template-columns: 1fr;
      gap: var(--space-sm);
    }
  }

  /* What is Lockstep */
  .what {
    display: grid;
    gap: var(--space-lg);
  }

  .what__statement {
    max-width: 22ch;
    font-size: var(--text-3xl);
    line-height: 1.1;
  }

  .what__body {
    display: grid;
    gap: var(--space-md);
  }

  @media (min-width: 48rem) {
    .what__body {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-md) var(--space-xl);
    }
  }

  .what__more {
    color: var(--color-cream);
  }

  .what__highlights {
    display: grid;
    gap: var(--space-sm);
    padding: var(--space-md) 0 0;
    border-top: 1px solid color-mix(in srgb, var(--color-cream) 18%, transparent);
    list-style: none;
  }

  .what__highlights li {
    display: flex;
    gap: var(--space-xs);
    max-width: none;
    color: var(--color-cream);
    font-weight: 600;
  }

  /* Tick drawn in CSS, so no icon library is needed */
  .what__highlights li::before {
    content: '';
    flex: none;
    width: 0.4em;
    height: 0.75em;
    margin: 0.2em 0.35em 0 0.15em;
    border: solid currentColor;
    border-width: 0 2px 2px 0;
    transform: rotate(45deg);
  }

  @media (min-width: 48rem) {
    .what__more {
    color: var(--color-cream);
  }

  .what__highlights {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-lg);
    }
  }

  /* Articles */
  .articles {
    display: grid;
    gap: var(--space-md);
  }

  .articles__rest {
    display: grid;
    gap: var(--space-sm);
    padding: 0;
    list-style: none;
  }

  .articles__rest li {
    max-width: none;
  }

  @media (min-width: 64rem) {
    .articles {
      grid-template-columns: 1.1fr 1fr;
    }
  }

  /* Product status */
  .product-status {
    display: grid;
    gap: var(--space-md);
  }

  @media (min-width: 48rem) {
    .product-status {
      grid-template-columns: 0.6fr 1.4fr;
      gap: var(--space-xl);
    }
  }

  .product-status__badge {
    justify-self: start;
    padding: 0.35rem 0.9rem;
    border-radius: var(--radius-pill);
    background: var(--color-green);
    color: var(--color-cream);
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  /* Partner call to action */
  .partner {
    display: grid;
    gap: var(--space-lg);
    align-items: end;
  }

  .partner h2 {
    font-size: var(--text-3xl);
    line-height: 1.08;
    letter-spacing: -0.015em;
  }

  .partner__icons {
    display: flex;
    gap: var(--space-md);
  }

  .partner__icons :global(.partner-icon) {
    width: 2.5rem;
    height: 2.5rem;
  }

  @media (min-width: 48rem) {
    .partner {
      grid-template-columns: 1fr auto;
      gap: var(--space-xl);
    }
  }
</style>
