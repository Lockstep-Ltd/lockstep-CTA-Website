---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
// PLACEHOLDER copy: replace with final wording before launch.
---

<BaseLayout
  title="Tools to help young adults stay in control of gambling"
  description="Lockstep builds preventative digital tools that help 18–25 year olds in the UK build healthy habits and stay in control of gambling."
>
  <PageHero title="Simple tools to help you stay in control of gambling, before it becomes a problem.">
    <p>
      Lockstep is a UK social venture building digital tools for young adults aged
      18–25. They help you notice your habits, set limits that suit you, and get support
      early.
    </p>
    <div class="button-row">
      <a class="button" href="/how-it-works/">See how Lockstep works</a>
      <a class="button button--secondary" href="/partner/">Partner with us</a>
    </div>
  </PageHero>

  <section class="section section--surface" aria-labelledby="who-heading">
    <div class="container stack-lg">
      <h2 id="who-heading">Who Lockstep is for</h2>
      <div class="grid grid--3">
        <article class="card stack">
          <h3>Young adults</h3>
          <p>
            Practical tools to help you keep gambling in check and stay in charge of
            your time and money.
          </p>
          <a href="/how-it-works/">How our tools work</a>
        </article>
        <article class="card stack">
          <h3>Universities and support services</h3>
          <p>
            Give students and young people an early, stigma-free way to look after their
            wellbeing.
          </p>
          <a href="/partner/">Work with us</a>
        </article>
        <article class="card stack">
          <h3>Funders and supporters</h3>
          <p>
            Help us grow prevention-first support that reaches young people before harm
            takes hold.
          </p>
          <a href="/partner/#funders">Support our work</a>
        </article>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="why-heading">
    <div class="container stack">
      <h2 id="why-heading">Why prevention matters</h2>
      <p>
        Most support is designed for when things have already gone wrong. Lockstep focuses on
        the earlier moments: building healthy habits and giving people the tools to stay in
        control from the start.
      </p>
      <p class="placeholder">
        [PLACEHOLDER: one sourced fact about gambling harm among young adults in the UK, with
        a link to the source.]
      </p>
      <p><a href="/about/">Read about our mission</a></p>
    </div>
  </section>
</BaseLayout>
