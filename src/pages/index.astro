---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import lockSteps from '../assets/brand/lock-steps.webp';
import Staircase from '../components/Staircase.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { getArticles } from '../lib/articles';
import { about, commitments, heroNote, status, steps, tagline } from '../data/product';
import { site } from '../data/site';

const [latest, ...recent] = await getArticles();
---

<BaseLayout title="Regain control. Redirect the urge." description={tagline.summary}>
  <section class="hero">
    <div class="container hero__grid">
      <div class="hero__copy">
        <p class="status enter">
          <span class="status__dot" aria-hidden="true"></span>
          {status.label}, UK
        </p>
        <h1 class="enter" style="--i: 1">
          {tagline.headline.split(/(?<=\.) /).map((line) => <span class="hero__line">{line}</span>)}
        </h1>
        <p class="lead enter" style="--i: 2">{tagline.summary}</p>
        <p class="hero__note enter" style="--i: 2">{heroNote}</p>
        <div class="button-row enter" style="--i: 3">
          <a class="button" href={site.appStoreUrl}>Download on the App Store <span class="arrow" aria-hidden="true">→</span></a>
          <a class="button button--secondary" href="/how-it-works/">See how it works</a>
        </div>
        <p class="hero__android enter" style="--i: 3">{status.android}</p>
      </div>

      <div class="hero__art enter" style="--i: 2">
        <!-- Lockstep's own lock-and-steps artwork from the original site: do not alter -->
        <Image src={lockSteps} alt="" widths={[320, 480, 640]} sizes="(min-width: 56rem) 28rem, 80vw" class="hero__img" loading="eager" />
      </div>
    </div>
  </section>

  <section class="commitments" aria-label="What we stand for">
    <ul class="container commitments__list" role="list">
      {commitments.map((item) => (
        <li class="reveal">{item}</li>
      ))}
    </ul>
  </section>

  <section class="section section--surface" aria-labelledby="how-heading">
    <div class="container">
      <div class="section-head reveal">
        <div class="stack">
          <h2 id="how-heading">How Lockstep works</h2>
          <p class="lead">Practical support that goes beyond high-risk moments.</p>
        </div>
        <a class="text-link" href="/how-it-works/">More on how it works <span class="arrow" aria-hidden="true">→</span></a>
      </div>
      <Staircase steps={steps} />
    </div>
  </section>

  <section class="section section--dark" aria-labelledby="what-heading">
    <div class="container what">
      <h2 id="what-heading" class="what__statement reveal">What is Lockstep</h2>
      <div class="what__body reveal">
        {about.paragraphs.slice(0, 2).map((text) => <p>{text}</p>)}
      </div>
      <ul class="what__highlights reveal" role="list">
        {about.highlights.map((item) => <li>{item}</li>)}
      </ul>
      <p class="reveal">
        <a class="text-link what__more" href="/about/">More about Lockstep <span class="arrow" aria-hidden="true">→</span></a>
      </p>
    </div>
  </section>

  {latest && (
    <section class="section" aria-labelledby="articles-heading">
      <div class="container">
        <div class="section-head reveal">
          <div class="stack">
            <h2 id="articles-heading">Articles &amp; insights</h2>
            <p class="lead">Ideas, research and stories about gambling, habits and regaining control.</p>
          </div>
          <a class="text-link" href="/articles/">All articles <span class="arrow" aria-hidden="true">→</span></a>
        </div>
        <div class="articles">
          <div class="reveal">
            <ArticleCard article={latest} variant="feature" />
          </div>
          <ul class="articles__rest" role="list">
            {recent.slice(0, 3).map((article) => (
              <li class="reveal"><ArticleCard article={article} /></li>
            ))}
          </ul>
        </div>
      </div>
    </section>
  )}

  <section class="section section--surface" aria-labelledby="partner-heading">
    <div class="container partner reveal">
      <div class="stack">
        <h2 id="partner-heading">Working with universities, charities and funders</h2>
        <p>
          If your organisation supports people affected by gambling, or you'd like to help
          Lockstep grow, we'd like to hear from you.
        </p>
      </div>
      <a class="button" href="/partner/">Partner with us <span class="arrow" aria-hidden="true">→</span></a>
    </div>
  </section>
</BaseLayout>

<style>
  /* Hero */
  .hero {
    padding-block: var(--space-xl) var(--space-2xl);
    overflow: clip;
  }

  .hero__grid {
    display: grid;
    gap: var(--space-xl);
    align-items: center;
  }

  @media (min-width: 56rem) {
    .hero__grid {
      grid-template-columns: 1.25fr 0.75fr;
      gap: var(--space-2xl);
    }

    .hero {
      padding-block: var(--space-2xl) var(--space-3xl);
    }
  }

  .hero__copy > * + * {
    margin-top: var(--space-md);
  }

  .hero h1 {
    font-size: clamp(2.5rem, 1.4rem + 3.8vw, 4.5rem);
    line-height: 1;
  }

  /* One sentence per line: "Regain control." / "Redirect the urge." */
  .hero__line {
    display: block;
  }

  .hero .lead {
    max-width: 46ch;
  }

  .hero__android {
    font-size: var(--text-sm);
  }

  .hero__note {
    color: var(--color-green);
    font-weight: 600;
  }

  .status {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.85rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    background: var(--color-white);
    color: var(--color-green);
    font-size: var(--text-sm);
    font-weight: 600;
  }

  /* Real status indicator: the app is in early access */
  .status__dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--color-emerald);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-emerald) 25%, transparent);
  }

  /* Panel colour matches the artwork's own background, so the image sits flush */
  .hero__art {
    display: grid;
    place-items: center;
    padding: var(--space-lg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    background: rgb(253 250 240);
  }

  .hero__art :global(.hero__img) {
    width: auto;
    max-height: 28rem;
  }

  @media (max-width: 55.99rem) {
    .hero__art :global(.hero__img) {
      max-height: 18rem;
    }
  }

  /* Commitments band */
  .commitments {
    border-block: 1px solid var(--color-border);
  }

  .commitments__list {
    display: grid;
    padding-block: var(--space-md);
    list-style: none;
  }

  .commitments__list li {
    max-width: none;
    padding-block: var(--space-sm);
    color: var(--color-green);
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .commitments__list li + li {
    border-top: 1px solid var(--color-border);
  }

  @media (min-width: 48rem) {
    .commitments__list {
      grid-template-columns: repeat(3, 1fr);
      padding-block: var(--space-lg);
    }

    .commitments__list li {
      padding: 0 var(--space-md);
    }

    .commitments__list li:first-child {
      padding-left: 0;
    }

    .commitments__list li + li {
      border-top: 0;
      border-left: 1px solid var(--color-border);
    }
  }

  /* What is Lockstep */
  .what {
    display: grid;
    gap: var(--space-lg);
  }

  .what__statement {
    max-width: 22ch;
    font-size: var(--text-3xl);
    line-height: 1.1;
  }

  .what__body {
    display: grid;
    gap: var(--space-md);
  }

  @media (min-width: 48rem) {
    .what__body {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-md) var(--space-xl);
    }
  }

  .what__more {
    color: var(--color-cream);
  }

  .what__highlights {
    display: grid;
    gap: var(--space-sm);
    padding: var(--space-md) 0 0;
    border-top: 1px solid color-mix(in srgb, var(--color-cream) 18%, transparent);
    list-style: none;
  }

  .what__highlights li {
    display: flex;
    gap: var(--space-xs);
    max-width: none;
    color: var(--color-cream);
    font-weight: 600;
  }

  /* Tick drawn in CSS, so no icon library is needed */
  .what__highlights li::before {
    content: '';
    flex: none;
    width: 0.4em;
    height: 0.75em;
    margin: 0.2em 0.35em 0 0.15em;
    border: solid currentColor;
    border-width: 0 2px 2px 0;
    transform: rotate(45deg);
  }

  @media (min-width: 48rem) {
    .what__more {
    color: var(--color-cream);
  }

  .what__highlights {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-lg);
    }
  }

  /* Articles */
  .articles {
    display: grid;
    gap: var(--space-md);
  }

  .articles__rest {
    display: grid;
    gap: var(--space-sm);
    padding: 0;
    list-style: none;
  }

  .articles__rest li {
    max-width: none;
  }

  @media (min-width: 64rem) {
    .articles {
      grid-template-columns: 1.1fr 1fr;
    }
  }

  /* Partner call to action */
  .partner {
    display: grid;
    gap: var(--space-md);
    align-items: center;
  }

  @media (min-width: 48rem) {
    .partner {
      grid-template-columns: 1fr auto;
      gap: var(--space-xl);
    }
  }
</style>
