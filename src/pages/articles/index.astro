---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { getArticles } from '../../lib/articles';

// Newest first. The newest is featured; the next three sit beside it, and
// the full list is on /articles/all/.
const articles = await getArticles();
const [latest, ...older] = articles;
const rest = older.slice(0, 3);
const hasMore = articles.length > rest.length + 1;
---

<BaseLayout
  title="Articles & insights"
  description="Practical ideas, research and stories around gambling, habits and regaining control, from the Lockstep team."
>
  <section class="articles-hero">
    <div class="container articles-hero__inner">
      <div class="stack">
        <h1 class="enter">Articles &amp; insights</h1>
        <p class="lead enter" style="--i: 1">
          Practical ideas, research and stories around gambling, habits and regaining control.
        </p>
      </div>
      <aside class="suggest enter" style="--i: 2" aria-labelledby="suggest-heading">
        <h2 id="suggest-heading">Found an article worth sharing?</h2>
        <p>Suggest it and we may feature it here.</p>
        <a class="text-link" href="/articles/suggest/">
          Suggest an article <span class="arrow" aria-hidden="true">→</span>
        </a>
      </aside>
    </div>
  </section>

  <section class="section articles-list" aria-label="All articles">
    <div class="container articles-grid">
      {latest && (
        <div class="articles-grid__feature enter" style="--i: 3">
          <ArticleCard article={latest} variant="feature" headingLevel="h2" />
        </div>
      )}
      <ul class="articles-grid__rest" role="list">
        {rest.map((article, i) => (
          <li class="enter" style={`--i: ${i + 4}`}>
            <ArticleCard article={article} headingLevel="h2" />
          </li>
        ))}
      </ul>
    </div>
    {hasMore && (
      <div class="container all-link">
        <a class="button button--secondary" href="/articles/all/">
          See all articles <span class="arrow" aria-hidden="true">→</span>
        </a>
        <a class="text-link rss-link" href="/rss.xml">RSS feed</a>
      </div>
    )}
  </section>
</BaseLayout>

<style>
  .articles-hero {
    padding-block: var(--space-2xl) var(--space-lg);
  }

  .articles-hero__inner {
    display: grid;
    gap: var(--space-lg);
    align-items: end;
  }

  .articles-hero h1 {
    font-size: var(--text-4xl);
  }

  @media (min-width: 56rem) {
    .articles-hero__inner {
      grid-template-columns: 1.6fr 1fr;
    }
  }

  .suggest {
    padding: var(--space-md);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-sage);
  }

  .suggest h2 {
    font-size: var(--text-lg);
  }

  .suggest p {
    margin-block: var(--space-3xs) var(--space-2xs);
  }

  .articles-list {
    padding-top: var(--space-md);
  }

  .articles-grid {
    display: grid;
    gap: var(--space-md);
  }

  .articles-grid__rest {
    display: grid;
    gap: var(--space-sm);
    padding: 0;
    list-style: none;
  }

  .all-link {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm) var(--space-lg);
    align-items: center;
    margin-top: var(--space-lg);
  }

  .articles-grid__rest li {
    max-width: none;
  }

  @media (min-width: 64rem) {
    .articles-grid {
      grid-template-columns: 1.1fr 1fr;
      align-items: stretch;
    }
  }
</style>
