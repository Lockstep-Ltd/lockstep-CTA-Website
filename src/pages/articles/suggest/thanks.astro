---
import BaseLayout from '../../../layouts/BaseLayout.astro';
---

<BaseLayout title="Thanks for your suggestion" description="Your article suggestion has been sent to the Lockstep team." noindex>
  <section class="section">
    <div class="container stack">
      <h1>Thanks for your suggestion</h1>
      <p class="lead">
        We've received it and will take a look. We'll let you know our decision by email.
      </p>
      <div class="button-row">
        <a class="button" href="/articles/">Back to articles</a>
        <a class="button button--secondary" href="/articles/suggest/">Suggest another</a>
      </div>
    </div>
  </section>
</BaseLayout>
