---
// Every published article, newest first. Linked from "See all articles" on /articles/.
// The "Sorted by date" switch is a checkbox styled as a switch. CSS (:has) turns the two-column
// grid into one column, newest at the top. No JavaScript: the list is already in date order.
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { getArticles } from '../../lib/articles';

const articles = await getArticles();
---

<BaseLayout
  title="All articles"
  description="Every article from Lockstep, newest first: practical ideas, research and stories around gambling, habits and regaining control."
>
  <PageHero title="All articles">
    <p class="lead">Practical ideas, research and stories around gambling, habits and regaining control.</p>
    <div class="all-articles__bar">
      <a class="text-link" href="/articles/">
        <span class="arrow" aria-hidden="true">←</span> Back to articles
      </a>
      <label class="switch">
        <span class="switch__label">Sorted by date</span>
        <input class="switch__input" type="checkbox" role="switch" id="by-date" />
        <span class="switch__track" aria-hidden="true"></span>
      </label>
    </div>
  </PageHero>

  <section class="section all-articles" aria-label="All articles, newest first">
    <div class="container">
      <ul class="all-articles__list" role="list">
        {articles.map((article) => (
          <li class="reveal"><ArticleCard article={article} headingLevel="h2" showDescription /></li>
        ))}
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .all-articles {
    padding-top: 0;
  }

  .all-articles__list {
    display: grid;
    gap: var(--space-sm);
    padding: 0;
    list-style: none;
  }

  .all-articles__list li {
    max-width: none;
    display: grid;
  }

  @media (min-width: 48rem) {
    .all-articles__list {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* Sorted by date: one column, newest first (the order the list is already in) */
  :root:has(#by-date:checked) .all-articles__list {
    grid-template-columns: 1fr;
    max-width: 52rem;
  }

  /* "Back to articles" on the left, the switch on the right, lined up with the grid's right edge */
  .all-articles__bar {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm) var(--space-lg);
    align-items: center;
    justify-content: space-between;
  }

  /* The switch: only useful where there are two columns, and only where :has() works */
  .switch {
    display: none;
  }

  @media (min-width: 48rem) {
    @supports selector(:has(*)) {
      .switch {
        display: inline-flex;
      }
    }
  }

  .switch {
    position: relative;
    gap: var(--space-xs);
    align-items: center;
    min-height: 2.75rem;
    color: var(--color-heading);
    font-weight: 600;
    cursor: pointer;
  }

  /* The real checkbox covers the switch, so it stays focusable and clickable */
  .switch__input {
    position: absolute;
    top: 50%;
    right: 0;
    z-index: 1;
    translate: 0 -50%;
    opacity: 0;
    width: 3rem;
    height: 1.75rem;
    margin: 0;
    cursor: pointer;
  }

  .switch__track {
    position: relative;
    flex: none;
    width: 3rem;
    height: 1.75rem;
    border: 2px solid var(--color-green);
    border-radius: var(--radius-pill);
    background: var(--color-white);
  }

  .switch__track::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 0.2rem;
    width: 1.1rem;
    height: 1.1rem;
    border-radius: 50%;
    background: var(--color-green);
    translate: 0 -50%;
  }

  .switch__input:checked + .switch__track {
    background: var(--color-green);
  }

  .switch__input:checked + .switch__track::after {
    left: calc(100% - 1.3rem);
    background: var(--color-cream);
  }

  .switch__input:focus-visible + .switch__track {
    outline: var(--focus-ring);
    outline-offset: var(--focus-offset);
  }

  @media (prefers-reduced-motion: no-preference) {
    .switch__track,
    .switch__track::after {
      transition:
        left var(--duration-fast) var(--ease-out),
        background-color var(--duration-fast) var(--ease-out);
    }

    /* A short fade as the layout changes (two names, so it runs both ways) */
    .all-articles__list {
      animation: list-in-grid var(--duration) var(--ease-out);
    }

    :root:has(#by-date:checked) .all-articles__list {
      animation-name: list-in-column;
    }

    @keyframes list-in-grid {
      from { opacity: 0; translate: 0 0.5rem; }
    }

    @keyframes list-in-column {
      from { opacity: 0; translate: 0 0.5rem; }
    }
  }
</style>
