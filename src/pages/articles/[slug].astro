---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { formatDate, getArticles, titleTransition, type Article } from '../../lib/articles';
import { articleNodes } from '../../lib/structured-data';

export async function getStaticPaths() {
  const articles = await getArticles();
  return articles.map((article) => ({
    params: { slug: article.id },
    props: { article, more: articles.filter((a) => a.id !== article.id).slice(0, 2) },
  }));
}

interface Props {
  article: Article;
  more: Article[];
}

const { article, more } = Astro.props;
const { title, description, date, author, authorRole, readingTime, watchUrl, references } = article.data;
const { Content } = await render(article);
const isoDate = date.toISOString().slice(0, 10);
---

<BaseLayout
  title={title}
  description={description}
  ogType="article"
  ogImage={`/og/articles/${article.id}.png`}
  ogImageAlt={`${title}, by ${author}`}
  structuredData={articleNodes(article)}
>
  <meta slot="head" property="article:published_time" content={isoDate} />
  <meta slot="head" name="author" content={author} />

  <div class="progress" aria-hidden="true"></div>

  <article class="article">
    <header class="article__header">
      <div class="container article__header-inner">
        <a class="text-link back enter" href="/articles/">
          <span class="arrow" aria-hidden="true">←</span> All articles
        </a>
        <h1 class="article__title" style={`view-transition-name: ${titleTransition(article)}`}>{title}</h1>
        <p class="article__dek enter" style="--i: 1">{description}</p>
        <p class="article__meta meta-list enter" style="--i: 2">
          <span>{author}</span>
          <time datetime={isoDate}>{formatDate(date)}</time>
          <span>{readingTime}</span>
        </p>
        {watchUrl && (
          <p class="enter" style="--i: 3">
            <a class="button" href={watchUrl}>View the original</a>
          </p>
        )}
      </div>
    </header>

    <div class="container">
      <div class="prose enter" style="--i: 3">
        <Content />
      </div>

      <footer class="signoff">
        <p class="signoff__name">{author}</p>
        {authorRole && <p>{authorRole}</p>}
      </footer>

      {references.length > 0 && (
        <details class="references" id="references">
          <summary>References <span class="references__count">({references.length})</span></summary>
          <ol>
            {references.map((ref) => (
              <li>
                {ref.citation}
                {ref.url && (
                  <>
                    {' '}
                    <a href={ref.url}>{new URL(ref.url).hostname.replace(/^www\./, '')}</a>
                  </>
                )}
              </li>
            ))}
          </ol>
        </details>
      )}
    </div>
  </article>

  {more.length > 0 && (
    <section class="section section--surface" aria-labelledby="more-heading">
      <div class="container">
        <div class="section-head">
          <h2 id="more-heading">Keep reading</h2>
          <a class="text-link" href="/articles/">All articles <span class="arrow" aria-hidden="true">→</span></a>
        </div>
        <ul class="more" role="list">
          {more.map((a) => (
            <li class="reveal"><ArticleCard article={a} /></li>
          ))}
        </ul>
      </div>
    </section>
  )}
</BaseLayout>

<style>
  /* Reading progress: a thin bar that fills as you scroll (no JavaScript) */
  .progress {
    display: none;
  }

  @supports (animation-timeline: scroll()) {
    .progress {
      display: block;
      position: fixed;
      inset: 0 0 auto;
      z-index: 20;
      height: 4px;
      background: var(--color-emerald);
      transform-origin: left;
      animation: progress linear both;
      animation-timeline: scroll(root);
    }
  }

  @keyframes progress {
    from { transform: scaleX(0); }
    to { transform: scaleX(1); }
  }

  .article__header {
    padding-block: var(--space-xl) var(--space-lg);
  }

  .article__header-inner {
    max-width: 52rem;
  }

  .article__header-inner > * + * {
    margin-top: var(--space-sm);
  }

  .back {
    font-size: var(--text-sm);
  }

  .article__title {
    font-size: var(--text-4xl);
    line-height: 1.05;
  }

  .article__dek {
    font-size: var(--text-lg);
    max-width: 44ch;
  }

  .article__meta {
    padding-top: var(--space-sm);
    border-top: 1px solid var(--color-border);
    color: var(--color-emerald);
    font-size: var(--text-sm);
    font-weight: 500;
  }

  /* Long-form reading styles for the Markdown body */
  .prose {
    max-width: 40rem;
    margin-inline: auto;
    padding-block: var(--space-md) var(--space-lg);
    font-size: clamp(1.0625rem, 1rem + 0.3vw, 1.1875rem);
    line-height: 1.75;
  }

  .prose > :global(* + *) {
    margin-top: 1.25em;
  }

  .prose :global(p:first-child::first-letter) {
    float: left;
    margin: 0.08em 0.12em 0 0;
    color: var(--color-green);
    font-family: var(--font-heading);
    font-size: 3.4em;
    font-weight: 600;
    line-height: 0.8;
  }

  .prose :global(:is(h2, h3)) {
    margin-top: 2em;
  }

  .prose :global(blockquote) {
    padding-left: var(--space-md);
    border-left: 3px solid var(--color-emerald);
    color: var(--color-green);
    font-family: var(--font-heading);
    font-size: 1.25em;
  }

  .signoff {
    max-width: 40rem;
    margin: 0 auto var(--space-2xl);
    padding-top: var(--space-md);
    border-top: 2px solid var(--color-green);
  }

  .signoff:has(+ .references) {
    margin-bottom: var(--space-md);
  }

  /* Sources cited in the article: collapsed behind a "References" link */
  .references {
    max-width: 40rem;
    margin: 0 auto var(--space-2xl);
    font-size: var(--text-sm);
  }

  .references summary {
    width: fit-content;
    padding-block: var(--space-3xs);
    color: var(--color-green);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 0.2em;
    cursor: pointer;
  }

  .references__count {
    font-weight: 400;
  }

  .references ol {
    margin-top: var(--space-sm);
    padding-left: 1.5em;
  }

  .references li + li {
    margin-top: var(--space-2xs);
  }

  .references a {
    overflow-wrap: anywhere;
  }

  .signoff__name {
    color: var(--color-green);
    font-family: var(--font-heading);
    font-size: var(--text-lg);
    font-weight: 600;
  }

  .more {
    display: grid;
    gap: var(--space-sm);
    padding: 0;
    list-style: none;
  }

  .more li {
    max-width: none;
  }

  @media (min-width: 48rem) {
    .more {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
