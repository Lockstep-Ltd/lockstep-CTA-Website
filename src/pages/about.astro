---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Figure from '../components/Figure.astro';
import { principles } from '../data/product';
// PLACEHOLDER copy: replace with final wording before launch.
---

<BaseLayout
  title="About"
  description="Lockstep is a UK social venture on a mission to reduce gambling-related harm among young adults through preventative digital tools."
>
  <PageHero eyebrow="About Lockstep" title="Helping young adults build healthy habits around gambling">
    <p>
      We're a UK social venture. Our mission is to reduce gambling-related harm among young
      adults by giving them simple, preventative tools that keep them in control.
    </p>
  </PageHero>

  <section class="section section--surface" aria-labelledby="principles-heading">
    <div class="container">
      <div class="stack reveal principles-head">
        <h2 id="principles-heading">Philosophy &amp; principles</h2>
        <p class="lead">
          A small set of principles guides every design decision. They keep us focused on what
          matters most: real support, real progress and real choice.
        </p>
      </div>
      <ol class="principles">
        {principles.map((item, i) => (
          <li class="principle reveal">
            <span class="principle__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section" aria-labelledby="prevention-heading">
    <div class="container stack reveal">
      <h2 id="prevention-heading">Why preventative tools matter</h2>
      <p>
        Gambling is easier to access than ever, and for many young adults it's part of
        everyday life online. Most support only becomes available once someone is already
        struggling. We think people deserve good tools earlier, before habits become hard to
        change.
      </p>
      <p>
        Prevention means meeting people where they are, without judgement. It means helping
        them notice patterns, make choices that feel right for them, and know where to turn if
        they want to talk to someone.
      </p>
      <p class="placeholder">
        [PLACEHOLDER: supporting evidence or research, with sources linked.]
      </p>
    </div>
  </section>

  <section class="section section--surface" aria-labelledby="founder-heading">
    <div class="container founder reveal">
      <Figure
        class="founder__photo"
        alt="Andrew Brink, founder of Lockstep"
        placeholder="PLACEHOLDER: founder photo"
        ratio="1"
        sizes="18rem"
      />
      <div class="stack">
        <h2 id="founder-heading">Meet the founder</h2>
        <p><strong>Andrew Brink</strong>, Founder</p>
        <p class="placeholder">
          [PLACEHOLDER: Andrew's story and why Andrew started Lockstep, in two or three short
          paragraphs.]
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .principles-head {
    margin-bottom: var(--space-lg);
  }

  .principles {
    display: grid;
    gap: var(--space-md);
    padding: 0;
    list-style: none;
  }

  @media (min-width: 48rem) {
    .principles {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-lg) var(--space-xl);
    }
  }

  .principle {
    max-width: none;
    padding-top: var(--space-sm);
    border-top: 2px solid var(--color-green);
  }

  .principle__num {
    display: block;
    margin-bottom: var(--space-2xs);
    color: var(--color-emerald);
    font-family: var(--font-heading);
    font-size: var(--text-2xl);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  .principle p {
    margin-top: var(--space-2xs);
  }

  .founder {
    display: grid;
    gap: var(--space-lg);
    align-items: center;
  }

  .founder :global(.founder__photo) {
    max-width: 18rem;
  }

  @media (min-width: 48rem) {
    .founder {
      grid-template-columns: 18rem 1fr;
    }
  }
</style>
