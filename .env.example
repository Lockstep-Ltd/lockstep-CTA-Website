# Copy this file to .env for local secrets. .env is ignored by Git.

# Article suggestions (/articles/suggest) are emailed via Resend (https://resend.com).
# Leave RESEND_API_KEY empty locally: `npm run dev` then prints suggestions in the dev log
# (`npx astro dev logs`) instead of sending them. In production, set it in Vercel.
RESEND_API_KEY=

# Optional overrides (defaults shown)
# SUGGEST_TO_EMAIL=articles@lockstep.uk
# SUGGEST_FROM_EMAIL=Lockstep website <website@lockstep.uk>
